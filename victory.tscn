[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://victory.gd" id="1"]

[node name="Victory" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.025, 0.09, 0.055, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(600, 400)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 22

[node name="Title" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
text = "¡NIVEL 1 COMPLETADO!"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 42

[node name="Subtitle" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
text = "Llegaste a la puerta final."
horizontal_alignment = 1
theme_override_font_sizes/font_size = 24

[node name="Message" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
text = "¡Buen trabajo!\nLa aventura continúa..."
horizontal_alignment = 1
theme_override_font_sizes/font_size = 20

[node name="BackButton" type="Button" parent="Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 58)
layout_mode = 2
text = "JUGAR DE NUEVO"
theme_override_font_sizes/font_size = 24

[node name="MenuButton" type="Button" parent="Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "VOLVER AL MENÚ"
theme_override_font_sizes/font_size = 20

[connection signal="pressed" from="Center/Panel/VBox/BackButton" to="." method="_on_back_button_pressed"]
[connection signal="pressed" from="Center/Panel/VBox/MenuButton" to="." method="_on_menu_button_pressed"]
